# CloudOps Control Plane Environment Variables

# Node Environment
NODE_ENV=development

# API Server Configuration
API_PORT=3000
API_HOST=0.0.0.0
API_LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://localhost:5432/cloudops
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Next.js Web Application
NEXT_PUBLIC_API_URL=http://localhost:3000
PORT=3001

# AWS Credentials (Scoped IAM Operator - Never Root)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=
AWS_READONLY_ROLE_ARN=
AWS_REMEDIATION_ROLE_ARN=

# Hermes Local Agent Daemon
HERMES_URL=http://127.0.0.1:8080
HERMES_SESSION_TOKEN=

# Client-Safe Public Env Configurations
NEXT_PUBLIC_AWS_REGION=eu-north-1
NEXT_PUBLIC_AWS_READONLY_ROLE_ARN=
NEXT_PUBLIC_AWS_REMEDIATION_ROLE_ARN=
