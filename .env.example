# CloudOps Unified Control Plane Configuration

# Node Environment
NODE_ENV=production

# API Server Configuration (Port 3000)
API_PORT=3000
API_HOST=0.0.0.0
API_LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001

# Database Configuration (PostgreSQL via Docker / Local)
DATABASE_URL=postgres://postgres@localhost:5432/cloudops
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
PGUSER=postgres

# Next.js Operator Web Application (Port 3001)
NEXT_PUBLIC_API_URL=http://localhost:3000
PORT=3001

# DefenseClaw Security Sidecar Gateway
DEFENSECLAW_ENDPOINT=http://localhost:8080/v1/evaluate

