# CloudOps Unified Control Plane Configuration

# Node Environment
NODE_ENV=production

# API Server Configuration (Port 3000)
API_PORT=3000
API_HOST=0.0.0.0
API_LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3001

# Database Configuration (PostgreSQL via Docker / Local)
DATABASE_URL=postgres://postgres@localhost:5432/cloudops
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
PGUSER=postgres

# Next.js Operator Web Application (Port 3001)
NEXT_PUBLIC_API_URL=http://localhost:3000
PORT=3001

# DefenseClaw Security Sidecar Gateway
DEFENSECLAW_ENDPOINT=http://localhost:8080/v1/evaluate
# Required: generate a cryptographically random token (e.g. openssl rand -hex 32)
DEFENSECLAW_GATEWAY_TOKEN=

# Hermes Autonomous Agent Daemon (External Host Engine)
HERMES_URL=http://localhost:8080
HERMES_BIN=hermes
HERMES_LIVE_INFERENCE=false

# ─────────────────────────────────────────────────────────────────────
# Phase 1 Prerequisites (added in Phase 0 groundwork — no values yet)
# ─────────────────────────────────────────────────────────────────────

# [DEV-ONLY — no human provisioning needed]
# Redis connection string. Used in Phase 1.2 (gateway session registry)
# and Phase 1.3 (STS credential cache). Default matches docker-compose redis service.
REDIS_URL=redis://localhost:6379

# [HUMAN-PROVISIONED — must be created before Phase 1.7 tasks can be completed]
# Slack incoming webhook URL. Create at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# [HUMAN-PROVISIONED — must be created before Phase 1.7 tasks can be completed]
# PagerDuty Events API v2 routing key. Create at: PagerDuty → Services → Integrations
PAGERDUTY_ROUTING_KEY=

# [HUMAN-PROVISIONED — requires IAM role creation in each monitored AWS account]
# IAM Role ARN that has read-only access to AWS Pricing API (for cost estimation in Phase 1.5).
# The CloudOps API process assumes this role via STS to fetch on-demand pricing data.
# Create the role with AWSPricingReadOnlyAccess + trust policy allowing the CloudOps task role.
AWS_PRICING_API_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/CloudOpsPricingReader

