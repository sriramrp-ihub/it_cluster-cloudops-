{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudOpsScopedRemediationAllow",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeServices",
        "ecs:DescribeTasks"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "cloudops-demo"
        }
      }
    },
    {
      "Sid": "CloudOpsExplicitDenyPrivilegeEscalation",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "account:*",
        "kms:Delete*",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    }
  ]
}
